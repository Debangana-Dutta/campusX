# Campus X environment (no real secrets here). All optional: the app runs locally with none of them set.
# Path variables below default correctly; only override with ABSOLUTE paths.
# DATASET_PATH=source_files/extracted/CrunchWeek_StarterPack/data/cit_public.json
# VALIDATOR_PATH=source_files/extracted/CrunchWeek_StarterPack/validator.py
# SAMPLE_DISRUPTION_PATH=source_files/extracted/CrunchWeek_StarterPack/examples/sample_disruption.json
# STATE_DIR=backend/var
# EXPORTS_DIR=exports
TEAM_NAME=Campus X
SOLVER_SEED=42
SOLVER_TIME_LIMIT_S=120
SOLVER_WORKERS=1
# Database: SQLite by default. For Supabase PostgreSQL use its connection string (needs a driver such as psycopg2-binary).
DATABASE_URL=
# Auth: local = labelled DEVELOPMENT stub with demo accounts; supabase = verify Supabase JWTs (role in app_metadata.role)
AUTH_MODE=local
DEMO_PASSWORD=change-me-for-any-shared-deployment
LOCAL_AUTH_SECRET=change-me
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# Backend-only. NEVER expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
# Part 2 (not used yet): GEMINI_API_KEY=
