# OptiCampus backend environment. Safe placeholders only - never commit real values.
# Every variable is optional for local development (defaults shown).

# ---- Environment
APP_ENV=development                 # set to "production" on Render: disables dev conveniences (reset-link logging, default-password seeding)
LOG_LEVEL=INFO
TEAM_NAME=OptiCampus
CORS_ORIGINS=http://localhost:5173  # comma-separated browser origins allowed to call the API (your Vercel URL in production)
FRONTEND_URL=http://localhost:5173  # used to build password-reset links

# ---- Database: SQLite by default. Production: Supabase/Render PostgreSQL connection string.
DATABASE_URL=
# e.g. postgresql+psycopg2://USER:PASSWORD@HOST:5432/postgres

# ---- Authentication (accounts live in the database; passwords are scrypt-hashed)
AUTH_MODE=local                     # "local" = built-in accounts (default). "supabase" = verify Supabase JWTs instead.
LOCAL_AUTH_SECRET=change-me-long-random   # REQUIRED in production: signs session tokens
SEED_DEMO_USERS=true                # creates the 5 demo accounts only when the users table is empty
DEMO_PASSWORD=change-me-before-demo # password given to seeded demo accounts (the app refuses the old default in production)
ALLOWED_EMAIL_DOMAINS=              # e.g. cit.ac.in ; empty = any valid email
RESET_TOKEN_TTL_MIN=30

# ---- Email for password reset (optional). Without it, development mode logs the reset link to the server console;
#      production mode sends nothing and never exposes the token.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=OptiCampus <no-reply@example.com>

# ---- Supabase (only if AUTH_MODE=supabase). The service-role key is backend-only; NEVER put it in the frontend.
SUPABASE_URL=
SUPABASE_JWT_SECRET=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Gemini (backend only). Empty = built-in rules power the booking parser and Campus Buddy.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# ---- Solver
SOLVER_SEED=42
SOLVER_TIME_LIMIT_S=120
SOLVER_WORKERS=1
